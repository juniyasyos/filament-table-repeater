{
    "name": "juniyasyos/table-repeater",
    "description": "A custom table repeater plugin for Filament Forms v4.",
    "keywords": [
        "awcodes",
        "juniyasyos",
        "laravel",
        "filament",
        "table repeater",
        "plugin"
    ],
    "homepage": "https://github.com/juniyasyos/filament-table-repeater",
    "license": "MIT",
    "authors": [
        {
            "name": "Adam Weston",
            "email": "awcodes1@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Ahmad Ilyas",
            "email": "ahmadilyasdahlan@gmail.com",
            "role": "Software Engineer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^4.0",
        "spatie/laravel-package-tools": "^1.13.5"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-faker": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Juniyasyos\\TableRepeater\\": "src"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Juniyasyos\\TableRepeater\\Tests\\": "tests/src",
            "Juniyasyos\\TableRepeater\\Tests\\Database\\Factories\\": "tests/database/factories"
        }
    },
    "scripts": {
        "pint": "vendor/bin/pint",
        "pest": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Juniyasyos\\TableRepeater\\TableRepeaterServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
